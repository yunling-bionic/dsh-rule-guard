{
  "name": "dsh-rule-guard",
  "version": "0.4.3",
  "description": "DSH plugin: review every code-modifying tool call against project rules and the current goal before it runs.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "examples",
    "scripts",
    "assets",
    "README.md",
    "README.en.md",
    "RULES.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "guardrail",
    "rules",
    "agent",
    "review"
  ],
  "license": "MIT",
  "author": "YL (韵铃)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunling-bionic/dsh-rule-guard.git"
  },
  "homepage": "https://github.com/yunling-bionic/dsh-rule-guard#readme",
  "bugs": {
    "url": "https://github.com/yunling-bionic/dsh-rule-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/yunling-bionic/dsh-rule-guard/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/yunling-bionic/dsh-rule-guard/zip/refs/heads/main",
      "git": "https://github.com/yunling-bionic/dsh-rule-guard.git"
    }
  }
}
