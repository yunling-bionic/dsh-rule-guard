{
  "name": "dsh-rule-guard",
  "version": "0.4.2",
  "description": "DSH plugin: review every code-modifying tool call against project rules and the current goal before it runs.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "examples",
    "scripts",
    "assets",
    "README.md",
    "README.en.md",
    "RULES.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "guardrail",
    "rules",
    "agent",
    "review"
  ],
  "license": "MIT",
  "author": "YL (韵铃)",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
